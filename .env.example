# Copy to .env.local (git-ignored). EXPO_PUBLIC_* values are inlined into the JS bundle,
# so for OTA/EAS builds also set them as EAS environment variables (see README).

# Backend base URL. For a local backend on an Android emulator use http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=https://nonbu-backend.onrender.com

# Google OAuth *Web* client ID (same value as the backend's GOOGLE_CLIENT_IDS)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
