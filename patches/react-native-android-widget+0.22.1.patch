@@ -0,0 +1,48 @@
+package com.reactnativeandroidwidget.builder.widget;
+
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.text.format.DateUtils;
+import android.util.TypedValue;
+import android.widget.TextView;
+
+import com.facebook.react.bridge.ReactApplicationContext;
+import com.facebook.react.bridge.ReadableMap;
+
+/**
+ * Reserves space for a live H:MM:SS count-up in the widget bitmap. Bitmap content can't tick, so
+ * RNWidget overlays a real Chronometer at this view's position; this view itself draws nothing.
+ */
+public class ChronometerWidget extends BaseWidget<TextView> {
+    public ChronometerWidget(ReactApplicationContext context, ReadableMap props) {
+        super(context, props);
+    }
+
+    @Override
+    protected TextView createView() {
+        return new TextView(appContext);
+    }
+
+    @Override
+    public void applyProps() {
+        // Same text, size and weight as the overlay so the reserved space matches it.
+        long elapsedSeconds = Math.max(0, (System.currentTimeMillis() - getStartedAt()) / 1000);
+        view.setText(DateUtils.formatElapsedTime(elapsedSeconds));
+        view.setTextSize(TypedValue.COMPLEX_UNIT_SP, getFontSize());
+        view.setTypeface(Typeface.DEFAULT_BOLD);
+        view.setTextColor(Color.TRANSPARENT);
+    }
+
+    /** Wall-clock start of the count-up, in epoch milliseconds. */
+    public long getStartedAt() {
+        return (long) props.getDouble("startedAt");
+    }
+
+    public float getFontSize() {
+        return props.hasKey("fontSize") ? (float) props.getDouble("fontSize") : 12;
+    }
+
+    public int getColor() {
+        return Color.parseColor(getString("color", "#000000"));
+    }
+}
