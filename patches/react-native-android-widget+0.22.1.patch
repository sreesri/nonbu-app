+    /** Overlays a live Chronometer on each ChronometerWidget, since the bitmap underneath can't tick. */
+    private void addChronometers(RemoteViews widgetView, int containerId, WidgetWithViews widgetWithViews) {
+        widgetView.removeAllViews(containerId);
+        ViewGroup rootView = (ViewGroup) widgetWithViews.getRootView();
+        for (ChronometerWidget chronometer : widgetWithViews.getChronometerWidgets()) {
+            View placeholder = chronometer.getView();
+            Rect bounds = new Rect();
+            placeholder.getDrawingRect(bounds);
+            rootView.offsetDescendantRectToMyCoords(placeholder, bounds);
+
+            RemoteViews overlay = new RemoteViews(appContext.getPackageName(), R.layout.rn_widget_chronometer);
+            overlay.setViewPadding(R.id.rn_widget_chronometer_positioner, bounds.left, bounds.top, 0, 0);
+            overlay.setTextViewTextSize(R.id.rn_widget_chronometer, TypedValue.COMPLEX_UNIT_SP, chronometer.getFontSize());
+            overlay.setTextColor(R.id.rn_widget_chronometer, chronometer.getColor());
+            // Chronometer counts from an elapsedRealtime() base, not wall-clock time.
+            long base = SystemClock.elapsedRealtime() - (System.currentTimeMillis() - chronometer.getStartedAt());
+            overlay.setChronometer(R.id.rn_widget_chronometer, base, null, true);
+            widgetView.addView(containerId, overlay);
+        }
+    }
